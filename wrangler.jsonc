{
  // Statische Website aus dist/, dazu ein kleines Worker-Skript nur fuer
  // /api/* (das Handwerker-Formular auf kontakt.html schreibt darueber
  // in die Google-Tabelle). Alle anderen Adressen liefert Cloudflare direkt aus
  // dist/ aus, ohne das Skript - _redirects und _headers gelten dort wie
  // bisher.
  //
  // "name" muss dem Worker entsprechen, der in Cloudflare angelegt ist.
  "name": "taskrunner",
  "compatibility_date": "2026-09-03",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // SHEET_URL und SHEET_GEHEIMNIS fuer die Google-Tabelle sind Secrets im
  // Dashboard und stehen bewusst nicht hier (Einrichtung in
  // werkzeuge/google-tabelle.gs).
  // Logs im Dashboard (Workers -> taskrunner -> Observability): zeigen
  // z. B. "Tabelle-Fehler" aus worker/index.js.
  // Hier eingetragen, damit ein Deploy den Schalter nicht zuruecksetzt.
  "observability": {
    "enabled": true
  }
}
