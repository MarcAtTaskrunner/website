# =====================================================================
# Matomo (Besucherstatistik) unter https://stats.taskrunner.de
#
# Liegt auf dem Server in public_html/stats/ - konsoleH laesst Ziele fuer
# Subdomains nur unterhalb von public_html zu. Im Repo:
# hetzner/matomo/htaccess, eingespielt vom Workflow "Matomo auf Hetzner"
# (.github/workflows/matomo-hetzner.yml).
#
# Diese Datei muss fuer sich allein stehen: Unter stats.taskrunner.de
# gilt die .htaccess der Website (eine Ebene hoeher) auf Hetzner NICHT
# mit - die Subdomain hat ihren eigenen Web-Root. Nur beim Aufruf als
# www.taskrunner.de/stats/ gelten beide, und der wird unten abgewiesen.
# =====================================================================

Options -Indexes
DirectoryIndex index.php

# PHP: gesperrt bis auf die Einstiege von Matomo (Oberflaeche,
# Zaehlpunkt). Die zweite Regel gewinnt fuer die Dateien, auf die sie
# passt. Matomo braucht von aussen keine andere PHP-Datei.
<FilesMatch "\.(php[0-9]?|phtml|phar)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(index|matomo|piwik)\.php$">
    Require all granted
</FilesMatch>

<IfModule mod_rewrite.c>
# Eigene Regeln; damit gelten die der Website hier nicht mehr.
RewriteEngine On

# Nur unter stats.taskrunner.de erreichbar, nicht als www.taskrunner.de/stats/
RewriteCond %{HTTP_HOST} !^stats\.taskrunner\.de(:[0-9]+)?$ [NC]
RewriteRule ^ - [R=404,L]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://stats.taskrunner.de%{REQUEST_URI} [R=301,L]

# Interna von Matomo: Einstellungen (Datenbank-Passwort), Sitzungen,
# Zwischenspeicher, Sprachdateien, Tests und das Konsolen-Skript. Matomo
# sperrt diese Ordner auch selbst, sobald es eingerichtet ist - hier
# gilt es vom ersten Moment an.
RewriteRule ^(config|tmp|lang|tests)(/|$) - [F,L]
RewriteRule ^console$ - [F,L]

# Versteckte Dateien und Sicherungen nie ausliefern
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule \.(sql|bak|log|ini|sh|inc|orig|old|zip)(\.gz)?$ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on' || %{req:X-Forwarded-Proto} == 'https'"
Header always set X-Content-Type-Options "nosniff"
# Falls doch die .htaccess der Website mitgilt: ihre CSP passt nicht zur
# Matomo-Oberflaeche; Matomo schickt seine eigene.
Header always unset Content-Security-Policy
# Das Zaehlskript laden alle Seiten der Website; einen Tag im Browser
# halten statt bei jedem Seitenaufruf nachzufragen.
<FilesMatch "^(matomo|piwik)\.js$">
    Header set Cache-Control "public, max-age=86400"
</FilesMatch>
</IfModule>
